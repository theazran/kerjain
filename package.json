{
  "name": "kerjain",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "build:css": "tailwindcss -i public/style.css -o public/app.css --content \"./views/**/*.ejs,./public/app.js\" --minify",
    "prestart": "npm run build:css",
    "start": "node app.js",
    "dev": "npm run build:css && node --watch app.js",
    "postinstall": "npm run build:css"
  },
  "description": "KERJAIN — Catat. Kerjakan. Buktikan. Aplikasi pencatatan pekerjaan harian.",
  "dependencies": {
    "@googleapis/drive": "^22.0.0",
    "@googleapis/sheets": "^14.0.0",
    "chart.js": "^4.5.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.5",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fullcalendar": "^6.1.21",
    "google-auth-library": "^10.9.1",
    "multer": "^2.4.0",
    "tailwindcss": "^3.4.19"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
