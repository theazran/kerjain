# KERJAIN — salin menjadi .env lalu isi. Jangan commit file .env.
PORT=3000
NODE_ENV=development
APP_TIMEZONE=Asia/Makassar

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Opsional. Kosongkan agar KERJAIN membuat spreadsheet "KERJAIN Database"
# dan folder "KERJAIN" di Google Drive akun yang login secara otomatis.
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# String acak panjang, misalnya hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Lokasi file sesi login (terenkripsi dengan SESSION_SECRET). Pastikan folder dapat ditulis.
SESSION_FILE=.sessions

# Opsional. Batasi akun yang boleh masuk (pisahkan dengan koma).
ALLOWED_EMAILS=

# Ukuran maksimal per file evidence (MB).
MAX_FILE_MB=10
